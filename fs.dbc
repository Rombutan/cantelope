CM_ BO_ 128 "CANopen SYNC message. Sent by the VCU.";
CM_ SG_ 403 VCU_ETC_READY_TO_DRIVE "Whether the Ready-To-Drive sequence has been completed. ETC Implausibilities will disable the motor even though RTD remains true and shutdown remains closed.";
CM_ SG_ 403 VCU_ETC_MOTOR_ENABLED "Whether the motor is enabled. True when Ready-To-Drive AND no ETC implausibilities are detected.";
CM_ SG_ 403 VCU_ETC_BATT_PRECHARGE_DONE "Whether the VCU has detected that the Tractive Battery has finished Precharging (read from BATT_TPDO_STATUS). Purely for debugging. (previously called 'TS_ACTIVE')";
CM_ SG_ 403 VCU_ETC_IMPLAUS_APPS_OUT_OF_RANGE "APPS1 or APPS2 reading is outside of expected voltage range (for >100ms) (T.4.2.10)";
CM_ SG_ 403 VCU_ETC_IMPLAUS_BPPS_OUT_OF_RANGE "BPPS reading is outside of expected voltage range (for >100ms) (not rules-required)";
CM_ SG_ 403 VCU_ETC_IMPLAUS_APPS_DEVIATION "APPS1 and APPS2 readings deviate by >10% (for >100ms) (T.4.2.4)";
CM_ SG_ 403 VCU_ETC_IMPLAUS_BSE_OUT_OF_RANGE "Front or Rear brake pressure sensor (BSE) is outside of expected voltage range (for >100ms) (T.4.3.3/4)";
CM_ SG_ 403 VCU_ETC_IMPLAUS_BRAKE_AND_ACCEL "Mechanical braking (BSE) is engaged while APPS is at >25% pedal travel (EV.4.7)";
CM_ SG_ 913 BATT_STATUS_SHUTDOWN_FINAL "Shutdown Circuit reading at the very end of the circuit, i.e. whether the IRs can close & Discharge can open (previously called 'IRs_Final')";
CM_ SG_ 913 BATT_STATUS_SHUTDOWN_IN "Shutdown Circuit reading after it enters the battery, before BMS & IMD relays";
CM_ SG_ 913 BATT_STATUS_SHUTDOWN_OUT "Shutdown Circuit reading before it leaves the battery, after BMS & IMD relays";
CM_ SG_ 913 BATT_STATUS_FAULT_MODULE_INDEX "The Tractive Battery module number index that the BMS fault occured in.";
CM_ SG_ 913 BATT_STATUS_FAULT_SENSOR_INDEX "The sensor index that caused the BMS fault for the given module number. For Voltage faults, this ranges from 0-5 for the 6 series cell groups in the module. For Temperature faults, this ranges from 0-11 for the 12 temperature sensors in the module.";
CM_ SG_ 913 BATT_STATUS_FAULT_INDEX "The final module-independent sensor index that caused the BMS fault. Calculated as module_index * NUM_SENSORS_PER_MODULE + sensor_index (where NUM_SENSORS_PER_MODULE is 6 for voltage faults and 12 for temperature faults).";
CM_ BO_ 2021 "Layer Setting Services (LSS) Transmit message. Sent by the charger board to the Zero SMPC charger to switch it into configuration mode";
CM_ BO_ 2020 "Layer Setting Services (LSS) Response message. Sent by the Zero SMPC charger in response to LSS configuration from the charger board";
BA_DEF_  "BusType" STRING ;
BA_DEF_DEF_  "BusType" "";
BA_ "BusType" "CAN";
